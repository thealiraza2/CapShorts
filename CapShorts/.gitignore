# ==========================================
# CapShorts - Subproject .gitignore
# ==========================================

# 1. Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
*.log
*.pem
*.key
*.cert
*.crt
*.pfx
secrets/
credentials.json

# 2. Dependencies & Package Managers
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun.lock
bun.lockb

# 3. Python Virtual Environments & Bytecode
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/

# 4. Build Artifacts & Desktop Targets
frontend/dist/
dist/
src-tauri/target/
target/
.turbo/

# 5. Media Dumps, Processing & Local Caches (Heavy Files)
backend/temp/
backend/outputs/
backend/cache/
backend/models/
backend/bin/
backend/ffmpeg.zip
temp/
outputs/
cache/
uploads/
*.mp4
*.mkv
*.mov
*.avi
*.wmv
*.flv
*.webm
*.mp3
*.wav
*.aac
*.flac
*.m4a
*.ass
*.srt

# 6. Compiled Binaries & OS Packages
*.exe
*.dll
*.dylib
*.so
*.dmg
*.pkg
*.app
*.msi
*.deb
*.rpm
*.zip
*.tar.gz
*.7z

# 7. IDE, Editor & OS Metadata
.DS_Store
Thumbs.db
[Dd]esktop.ini
.vscode/
.idea/
