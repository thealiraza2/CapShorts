# ==========================================
# CapShorts Engine Environment Configuration
# ==========================================
# Copy this file to .env and insert your personal/master keys.
# NEVER commit your actual .env file to public Git repositories!

# ⚡ Groq Cloud Whisper Turbo API Key (Free tier: 7,200 requests/day)
# Get your free key at: https://console.groq.com/keys
# Multiple keys can be comma-separated for automatic round-robin load-balancing
GROQ_API_KEYS=gsk_your_groq_api_key_here

# 🎬 Pexels Stock Footage API Key (Optional, for automated B-roll insertion)
# Get your free key at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# 🖥️ Server Network Binding (Defaults to localhost)
HOST=127.0.0.1
PORT=8000
